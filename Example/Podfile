platform :ios, '15.0'
use_frameworks!

# Fork of IrohaCrypto whose ed25519 is an xcframework with an arm64 simulator slice
def iroha_crypto
    pod 'IrohaCrypto/Iroha', :git => 'https://github.com/soramitsukhmer/ios-crypto.git', :branch => 'feature/iroha_arm64_simulator'
end

target 'IrohaExample' do
    pod 'IrohaCommunication', :path => '../'
    iroha_crypto
end

target 'IntegrationTestHost' do
    pod 'IrohaCommunication', :path => '../'
    iroha_crypto

    target 'UnitTests' do
        inherit! :search_paths
    end

    target 'IntegrationTests' do
        inherit! :search_paths
    end
end

post_install do |installer|
    installer.pods_project.targets.each do |target|
        target.build_configurations.each do |config|
            config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
            config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        end

        # BoringSSL 10.x passes -GCC_WARN_INHIBIT_ALL_WARNINGS, which modern clang rejects as '-G'
        target.source_build_phase.files.each do |file|
            flags = file.settings && file.settings['COMPILER_FLAGS']
            next unless flags
            file.settings['COMPILER_FLAGS'] = flags.gsub('-GCC_WARN_INHIBIT_ALL_WARNINGS', '').squeeze(' ')
        end
    end
end
